output ["sequence = ",_toString_BEHAVIOR(sequence,true,false),";\n","states = ",_toString_STATE(states,true,false),";\n","service_status = ",_toString_STATUS(service_status,true,false),";\n","facts_service_status = ",_toString_STATUS(facts_service_status,true,false),";\n","cost = ",showDzn(cost),";\n"];
function string : _toString_STATUS(array [$U] of opt STATUS: x,bool: b,bool: json) = let {array [int] of opt STATUS: xx = array1d(x)} in (("["++join(", ",[_toString_STATUS(xx[i],b,json) | i in index_set(xx)]))++"]");
function string : _toString_STATUS(opt int: x,bool: b,bool: json) = if occurs(x) then if b then showDznId(_enum_to_string_0_STATUS[deopt(x)]) elseif json then ("{\"e\":"++show(_enum_to_string_0_STATUS[deopt(x)]))++"}" else _enum_to_string_0_STATUS[deopt(x)] endif else if json then "null" else "<>" endif endif;
function string : _toString_STATE(array [$U] of opt STATE: x,bool: b,bool: json) = let {array [int] of opt STATE: xx = array1d(x)} in (("["++join(", ",[_toString_STATE(xx[i],b,json) | i in index_set(xx)]))++"]");
function string : _toString_STATE(opt int: x,bool: b,bool: json) = if occurs(x) then if b then showDznId(_enum_to_string_0_STATE[deopt(x)]) elseif json then ("{\"e\":"++show(_enum_to_string_0_STATE[deopt(x)]))++"}" else _enum_to_string_0_STATE[deopt(x)] endif else if json then "null" else "<>" endif endif;
function string : _toString_BEHAVIOR(array [$U] of opt BEHAVIOR: x,bool: b,bool: json) = let {array [int] of opt BEHAVIOR: xx = array1d(x)} in (("["++join(", ",[_toString_BEHAVIOR(xx[i],b,json) | i in index_set(xx)]))++"]");
function string : _toString_BEHAVIOR(opt int: x,bool: b,bool: json) = if occurs(x) then if b then showDznId(_enum_to_string_0_BEHAVIOR[deopt(x)]) elseif json then ("{\"e\":"++show(_enum_to_string_0_BEHAVIOR[deopt(x)]))++"}" else _enum_to_string_0_BEHAVIOR[deopt(x)] endif else if json then "null" else "<>" endif endif;
array [1..10] of int: cost;
set of int: STATUS = 1..2;
array [1..2] of string: _enum_to_string_0_STATUS = ["enabled","disabled"];
array [1..10+1] of int: facts_service_status;
array [1..10+1] of int: service_status;
